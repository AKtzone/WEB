---
interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  slug: string;
  readingTime?: number;
}

const { title, description, date, tags, slug, readingTime } = Astro.props;
const formattedDate = new Date(date).toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card">
  <div class="card-image">📝</div>
  <div class="card-content">
    <h3 class="card-title">
      <a href={`/WEB/blog/${slug}`}>{title}</a>
    </h3>
    <p class="card-meta">
    {formattedDate}
    {readingTime && <span> · ⏱ {readingTime} 分钟阅读</span>}
  </p>
    <p class="card-description">{description}</p>
    {tags.length > 0 && (
      <div class="tags">
        {tags.map(tag => (
          <span class="tag" key={tag}>{tag}</span>
        ))}
      </div>
    )}
  </div>
</article>
