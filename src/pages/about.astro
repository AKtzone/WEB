---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  'HTML5', 'CSS3', 'JavaScript', 'TypeScript',
  'React', 'Vue', 'Astro', 'Node.js',
  'Python', 'Git', 'Docker', 'Linux'
];
---

<BaseLayout title="关于 ZONE" currentPath="/WEB/about">
  <div class="about">
    <section class="about-section">
      <h2>🌌 关于 ZONE</h2>
      <p>
        这里是 ZONE，一个探索技术与创意的数字空间。我热衷于发现新技术，并将其应用到有趣的项目中。
      </p>
      <p>
        通过代码创造价值，用设计提升体验。每一行代码都是通往未来的桥梁。
      </p>
    </section>

    <section class="about-section">
      <h2>🛠️ 技能栈</h2>
      <div class="skills">
        {skills.map(skill => (
          <span class="skill-tag" key={skill}>{skill}</span>
        ))}
      </div>
    </section>

    <section class="about-section">
      <h2>📧 联系我</h2>
      <ul class="contact-list">
        <li>
          <span>📧</span>
          <a href="mailto:zone@example.com">zone@example.com</a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
